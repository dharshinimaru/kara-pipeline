<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.karalabs.pipeline</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/dharshinimarudhu/kara-pipeline/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/dharshinimarudhu/kara-pipeline</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>OPENALEX_MAILTO</key>
    <string>dharshini@karadiam.com</string>
  </dict>

  <!-- 09:00, 12:00 and 15:00 local, every day. The OpenAlex daily budget
       resets at midnight UTC, so all three runs share one day's allowance;
       each run uses roughly 150 of about 1000 credits. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <!-- If the Mac was asleep or off at 09:00, run at the next opportunity. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/dharshinimarudhu/kara-pipeline/data/log/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dharshinimarudhu/kara-pipeline/data/log/launchd.err.log</string>
</dict>
</plist>
